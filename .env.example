# Auto-Clipper Telegram Bot Environment Configuration
# Copy this file to .env and fill in your values.

# 1. Telegram Bot Token from @BotFather (Required)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Your Telegram User ID from @userinfobot (Required, comma separated for multiple users)
# If left empty, the first user to message /start will be accepted.
ALLOWED_USER_IDS=

# 3. Maximum Job Time Budget in Minutes (Default: 10)
MAX_JOB_MINUTES=10

# 4. Defaults
DEFAULT_CLIPS=5
DEFAULT_LAYOUT=top       # Options: top (facecam top + gameplay bottom), topleft, topright
DEFAULT_FIT=pad          # Options: pad (clean centered solid background), blur, crop
DEFAULT_LENGTH=20-45     # Options: 15-30, 20-45, 30-58 (all strictly under 1 min)
DEFAULT_SUBS=false       # Options: false (no subtitles - clean video), true

# 5. Models (Faster-Whisper & Ollama)
WHISPER_MODEL=base       # Options: tiny, base, small, medium
OLLAMA_MODEL=llama3.1:8b # Optional local LLM for transcript reasoning
OLLAMA_URL=http://localhost:11434

# 6. YouTube Bot-Check Fixes (Optional)
# If YouTube asks to confirm you're not a bot, specify your browser: chrome, edge, or firefox
YTDLP_COOKIES_BROWSER=
# Or specify path to a cookies.txt file:
YTDLP_COOKIES_FILE=

# 7. Self-Hosted Telegram Bot API Server (Optional, allows video uploads > 20 MB up to 2 GB)
TELEGRAM_API_BASE=
